* {
    font-family: Segoe UI;
    font-size: 14px;
}

QMainWindow {
    background: #f6f7fb;
}

#TopTitle {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
}

#ThemeToggle {
    background: white;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px;
}

#ThemeToggle:hover {
    background: #f3f4f6;
}

#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
}

#PageSubtitle {
    color: #4b5563;
}

#Card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 14px;
}

#Input {
    background: white;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 10px;
}

#Input:focus {
    border: 1px solid #2563eb;
}

#PrimaryButton {
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    font-weight: 600;
}

#PrimaryButton:hover {
    background: #1d4ed8;
}

#SecondaryButton {
    background: transparent;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 10px 14px;
}

#SecondaryButton:hover {
    background: #f3f4f6;
}

#ErrorLabel {
    color: #b91c1c;
}
